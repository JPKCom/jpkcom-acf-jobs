msgstr "pro Jahr"

#: includes/admin-pages.php:28 includes/admin-pages.php:29
msgid "Options"
msgstr "Optionen"

#: includes/admin-pages.php:69
msgid "Archive Settings"
msgstr "Archiv-Einstellungen"

